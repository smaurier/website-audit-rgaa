---
/*
  Adresse e-mail protégée des bots sans sacrifier l'accessibilité.

  - Sans JS : fallback texte "user (at) domaine (dot) com" (pas de @ à récolter,
    pas de mailto: dead).
  - Avec JS : l'adresse est reconstruite à partir de deux data-attributs
    base64 (utilisateur et domaine séparés + sujet), remplacée dynamiquement
    par un vrai lien mailto: cliquable. Bots qui parsent uniquement le HTML
    ne voient jamais l'adresse en clair.

  Aucun lien mort. Lecture correcte par lecteur d'écran (le fallback reste
  compréhensible, le lien mailto: prend le relais dès que le JS charge).
*/
interface Props {
  user: string;
  domain: string;
  subject?: string;
}
const { user, domain, subject } = Astro.props;

// Encodage base64 séparé pour user et domain : un scraper qui décode
// béatement chaque data-* ne récupère pas l'adresse complète, il faut
// concaténer volontairement.
const toB64 = (s: string) => Buffer.from(s, 'utf8').toString('base64');
const encUser = toB64(user);
const encDomain = toB64(domain);
const encSubject = subject ? toB64(subject) : '';

// Fallback lisible pour no-JS : notation (at)/(dot), zéro @ dans le HTML.
const display = `${user} (at) ${domain.replace(/\./g, ' (dot) ')}`;
---
<span
  class="email"
  data-u={encUser}
  data-d={encDomain}
  data-s={encSubject}
>{display}</span>

<script>
  // Reconstruit et remplace tous les emails obfusqués une seule fois.
  const decode = (s: string | undefined) => (s ? atob(s) : '');
  for (const el of document.querySelectorAll<HTMLElement>('span.email')) {
    const user = decode(el.dataset.u);
    const domain = decode(el.dataset.d);
    if (!user || !domain) continue;
    const addr = `${user}@${domain}`;
    const subject = decode(el.dataset.s);
    const a = document.createElement('a');
    a.href = `mailto:${addr}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
    a.textContent = addr;
    a.className = 'email';
    a.rel = 'nofollow';
    el.replaceWith(a);
  }
</script>
