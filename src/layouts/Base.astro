---
// Polices auto-hébergées (Fontsource) — pas de CDN Google Fonts (RGPD)
import '@fontsource/uncial-antiqua';        // wordmark « Nuada » uniquement
import '@fontsource/fraunces/600.css';      // titres
import '@fontsource/fraunces/700.css';
import '@fontsource/fraunces/900.css';      // h1
import '@fontsource/fraunces/900-italic.css'; // accents italiques du h1
import '../styles/global.css';
import { ui, locales, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  preloadImages?: { href: string; type?: string }[];
}

const { lang, title, description, preloadImages } = Astro.props;
const t = ui[lang];
const l = t.layout;
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const site = Astro.site ?? new URL('https://nuada-audit.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogLocale = { fr: 'fr_FR', en: 'en_US', es: 'es_ES' }[lang];
const ogImage = new URL('/og-image.png', site).href;
const ogImageAlt = {
  fr: "Nuada, main d'argent sur fond vert forêt : l'auditeur qui code la solution. RGAA, WCAG, European Accessibility Act.",
  en: "Nuada silver hand on forest green: the auditor who codes the fix. RGAA, WCAG, European Accessibility Act.",
  es: "Nuada, mano de plata sobre verde bosque: el auditor que programa la solución. RGAA, WCAG, European Accessibility Act.",
}[lang];

// Données structurées — l'entité Nuada pour Google et les LLM (GEO)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Nuada',
  description: t.meta.description,
  url: site.href,
  inLanguage: ['fr', 'en', 'es'],
  founder: { '@type': 'Person', name: 'Sylvain Maurier' },
  knowsAbout: [
    'Accessibilité numérique',
    'RGAA 4',
    'WCAG 2.2',
    'European Accessibility Act',
    'EN 301 549',
    'React',
    'React Native',
  ],
  areaServed: ['France', 'Europe', 'España', 'Latin America', 'United States'],
  makesOffer: [
    {
      '@type': 'Offer',
      name: t.offer.paliers[0].nom,
      price: '1200',
      priceCurrency: 'EUR',
      description: t.offer.paliers[0].scope,
    },
    {
      '@type': 'Offer',
      name: t.offer.paliers[1].nom,
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: '4900',
        priceCurrency: 'EUR',
      },
      description: t.offer.paliers[1].scope,
    },
    {
      '@type': 'Offer',
      name: t.offer.paliers[2].nom,
      description: t.offer.paliers[2].scope,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {preloadImages?.map((p) => (
      <link rel="preload" as="image" href={p.href} type={p.type} fetchpriority="high" />
    ))}
    <meta name="google-site-verification" content="EMAcDfRSRRazsjSjlwlXtu89Qk4MJICjSAw45mQLSMY" />
    <!-- View Transitions cross-document : le pill de langue actif glisse d'une langue a l'autre lors du changement de page. -->
    <style is:inline>
      @view-transition { navigation: auto; }
      ::view-transition-group(lang-active) { animation-duration: 380ms; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation-duration: 1ms !important; }
      }
    </style>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nuada" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {Object.entries(locales).map(([code, { path }]) => (
      <link rel="alternate" hreflang={code} href={new URL(path, site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={site.href} />
    <script is:inline>
      // Anti-flash : applique le thème choisi avant le premier rendu
      // + marqueur js pour les états initiaux des reveals (sans JS, rien n'est masqué)
      (function () {
        document.documentElement.classList.add('js');
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{l.skip}</a>

    <!-- Sprite SVG global : main d'argent + logo 3c (torque-parapluie main levée). Décoratif, réutilisé par <use>. -->
    <svg aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute">
      <defs>
        <linearGradient id="silver" x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
          <stop offset="0" stop-color="#e2e6eb" />
          <stop offset="0.5" stop-color="#8d97a1" />
          <stop offset="1" stop-color="#c4cad1" />
        </linearGradient>
        <!-- Motif "filet tressé" : deux vagues qui s'entrelacent. Décoratif, jamais porteur d'information. -->
        <pattern id="weave" width="36" height="16" patternUnits="userSpaceOnUse">
          <path d="M0 8 C6 2 12 2 18 8 C24 14 30 14 36 8" fill="none" stroke="#98a2ac" stroke-width="2.4" />
          <path d="M0 8 C6 14 12 14 18 8 C24 2 30 2 36 8" fill="none" stroke="#6f7a84" stroke-width="2.4" />
        </pattern>
        <!-- Main pleine, monolithique — utilisée en filigrane, en icône du hero, dans le sceau. -->
        <g id="hand">
          <path d="M5 17 a9 6.5 0 0 0 18 0 z" />
          <rect x="5" y="11.2" width="3" height="7" rx="1.5" />
          <rect x="8.75" y="7.6" width="3" height="10.6" rx="1.5" />
          <rect x="12.5" y="6.2" width="3" height="12" rx="1.5" />
          <rect x="16.25" y="7.6" width="3" height="10.6" rx="1.5" />
          <rect x="20" y="11.2" width="3" height="7" rx="1.5" />
        </g>
        <!-- Logo 3c : main levée dans un torque ouvert vers le bas (parapluie / accueil). currentColor pour piloter avec CSS. -->
        <g id="logo3c">
          <circle cx="14" cy="14" r="11.5" fill="none" stroke="currentColor" stroke-width="2.4"
            stroke-dasharray="58.2 14" stroke-linecap="round" transform="rotate(125 14 14)" />
          <g transform="translate(6.4 5.6) scale(0.55)" fill="currentColor">
            <path d="M5 17 a9 6.5 0 0 0 18 0 z" />
            <rect x="5" y="11.2" width="3" height="7" rx="1.5" />
            <rect x="8.75" y="7.6" width="3" height="10.6" rx="1.5" />
            <rect x="12.5" y="6.2" width="3" height="12" rx="1.5" />
            <rect x="16.25" y="7.6" width="3" height="10.6" rx="1.5" />
            <rect x="20" y="11.2" width="3" height="7" rx="1.5" />
          </g>
        </g>
        <!-- Torque seul (couronne parapluie) : réutilisé en filigrane des sections marque. -->
        <g id="torque">
          <circle cx="60" cy="64" r="46" fill="none" stroke="url(#silver)" stroke-width="8"
            stroke-dasharray="253 36" stroke-linecap="round" transform="rotate(112.5 60 64)" />
          <circle cx="42.4" cy="106.5" r="6.5" fill="url(#silver)" />
          <circle cx="77.6" cy="106.5" r="6.5" fill="url(#silver)" />
        </g>
      </defs>
    </svg>

    <header class="container site-header" role="banner">
      <span class="site-header-bg" aria-hidden="true"></span>
      <a href={locales[lang].path} class="brand">
        <svg class="brand-mark" aria-hidden="true" focusable="false" viewBox="0 0 28 28" width="28" height="28">
          <use href="#logo3c" />
        </svg>
        Nuada
      </a>

      <!-- Bouton hamburger : visible < 900px, ouvre le panneau de navigation. -->
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="menu-panel"
        aria-label={l.menuOpen}
        data-menu-toggle
      >
        <svg class="menu-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
          <path class="menu-icon-bar menu-icon-bar-top" d="M4 7h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path class="menu-icon-bar menu-icon-bar-mid" d="M4 12h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path class="menu-icon-bar menu-icon-bar-bot" d="M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Panneau menu : inline > 900px, drawer plein ecran < 900px. -->
      <div id="menu-panel" class="menu-panel" data-open="false">
      <button
        type="button"
        class="menu-close"
        aria-label={l.menuClose}
        data-menu-close
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <nav class="menu-nav" role="navigation" aria-label={l.nav}>
        <ul class="nav-list">
          <li><a class="nav-link" href="#offre">{l.offer}</a></li>
          <li><a class="nav-link" href="#methode">{l.method}</a></li>
          <li><a class="nav-link" href="#faq">{l.faq}</a></li>
          <li><a class="nav-link" href="#contact">{l.contact}</a></li>
        </ul>
      </nav>
      <nav class="menu-lang" role="navigation" aria-label={l.langLabel}>
        <ul class="lang-pills">
          {Object.entries(locales).map(([code, { label, path }]) => (
            <li>
              <a
                href={path}
                lang={code}
                hreflang={code}
                data-label={label}
                aria-current={code === lang ? 'true' : undefined}
              >
                <span>{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <!-- Le bouton de theme est injecte ici par JS (pas de controle mort sans JS) -->
      <span
        data-theme-mount
        data-label={l.theme.label}
        data-auto={l.theme.auto}
        data-light={l.theme.light}
        data-dark={l.theme.dark}
      ></span>
      </div>
      <span id="theme-status" role="status" class="visually-hidden"></span>
    </header>

    <script>
      const mount = document.querySelector<HTMLElement>('[data-theme-mount]');
      if (mount) {
        const d = mount.dataset;
        const labels: Record<string, string | undefined> = { auto: d.auto, light: d.light, dark: d.dark };
        const order = ['auto', 'light', 'dark'];
        const status = document.getElementById('theme-status');

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'theme-toggle';
        const value = document.createElement('span');
        btn.append(`${d.label} : `, value);
        mount.replaceWith(btn);

        const current = () => document.documentElement.dataset.theme ?? 'auto';
        const render = () => { value.textContent = labels[current()] ?? ''; };

        btn.addEventListener('click', () => {
          const next = order[(order.indexOf(current()) + 1) % order.length];
          const apply = () => {
            if (next === 'auto') {
              delete document.documentElement.dataset.theme;
              localStorage.removeItem('theme');
            } else {
              document.documentElement.dataset.theme = next;
              localStorage.setItem('theme', next);
            }
            render();
          };
          // Fondu de theme via View Transitions, si dispo et mouvement accepte
          if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.startViewTransition(apply);
          } else {
            apply();
          }
          if (status) status.textContent = `${d.label} : ${labels[next]}`;
        });

        render();
      }

      // Hamburger mobile : ouvre / ferme le panneau, focus trap, ESC, click backdrop,
      // fermeture auto sur ancre. Silencieux au-dessus du breakpoint desktop.
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menuPanel = document.getElementById('menu-panel');
      const menuClose = document.querySelector<HTMLButtonElement>('[data-menu-close]');
      if (menuToggle && menuPanel) {
        const mqDesktop = matchMedia('(min-width: 900px)');
        let lastFocus: HTMLElement | null = null;

        const focusable = () => Array.from(
          menuPanel.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])'
          )
        ).filter((el) => !el.hasAttribute('hidden') && el.offsetParent !== null);

        const setOpen = (open: boolean) => {
          menuPanel.dataset.open = open ? 'true' : 'false';
          menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          document.documentElement.classList.toggle('menu-locked', open);
          if (open) {
            lastFocus = document.activeElement as HTMLElement;
            const first = focusable()[0];
            first?.focus();
          } else if (lastFocus) {
            lastFocus.focus();
            lastFocus = null;
          }
        };

        menuToggle.addEventListener('click', () => setOpen(menuPanel.dataset.open !== 'true'));
        menuClose?.addEventListener('click', () => setOpen(false));

        // ESC ferme
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menuPanel.dataset.open === 'true') {
            e.preventDefault();
            setOpen(false);
          }
        });

        // Tab / Shift+Tab : trap focus dans le panneau quand ouvert (mobile only)
        menuPanel.addEventListener('keydown', (e) => {
          if (menuPanel.dataset.open !== 'true' || e.key !== 'Tab') return;
          const items = focusable();
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });

        // Clic sur ancre interne : ferme le menu
        menuPanel.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
          a.addEventListener('click', () => {
            if (menuPanel.dataset.open === 'true') setOpen(false);
          });
        });

        // Repasse en desktop : force la fermeture propre
        mqDesktop.addEventListener('change', (e) => {
          if (e.matches && menuPanel.dataset.open === 'true') setOpen(false);
        });
      }

      // Reveals au scroll — uniquement si le mouvement est accepte
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }

      // Boutons magnétiques — pointeur fin uniquement, mouvement accepté uniquement.
      // Purement décoratif : n'affecte ni le clavier, ni la cible tactile.
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        matchMedia('(pointer: fine)').matches
      ) {
        for (const b of document.querySelectorAll<HTMLElement>('.btn')) {
          b.addEventListener('pointermove', (e) => {
            const r = b.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) / (r.width / 2);
            const y = (e.clientY - r.top - r.height / 2) / (r.height / 2);
            b.style.translate = `${(x * 5).toFixed(1)}px ${(y * 4).toFixed(1)}px`;
          });
          b.addEventListener('pointerleave', () => {
            b.style.translate = '';
          });
        }
      }
    </script>

    <!-- tabindex=-1 : garantit le déplacement effectif du focus via le lien d'évitement (RGAA 12.7) -->
    <main id="main" role="main" tabindex="-1">
      <slot />
    </main>

    <footer class="container site-footer" role="contentinfo">
      <p>© {new Date().getFullYear()} {l.footerRights}</p>
      <p set:html={l.footerProof} />
      <p><a href="/mentions-legales/" hreflang="fr">{l.legalLink}</a></p>
    </footer>
  </body>
</html>
